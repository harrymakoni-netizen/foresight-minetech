# Next.js reads .env.local. Python workers need their own exported environment.
# Copy names only to Vercel project Settings > Environment Variables, then redeploy.
# All values below are SERVER ONLY. Never use NEXT_PUBLIC_ for secrets.
# See docs/INTEGRATIONS_SETUP.md for exact setup, health checks and asset requirements.

# Hosted: use the Supabase transaction-pooler URI with TLS, or integration POSTGRES_URL.
# Local development: leave both unset to use isolated SQLite.
DATABASE_URL=
POSTGRES_URL=
BETTER_AUTH_URL=http://localhost:3000
# Required in production; generate privately with openssl rand -hex 32.
BETTER_AUTH_SECRET=
FORESIGHT_TRUSTED_ORIGINS=
FORESIGHT_DATABASE_PATH=
# Private Vercel Blob integration token; never use public storage for clips.
BLOB_READ_WRITE_TOKEN=

# AI option A: AI Gateway. Use provider/model ID from https://ai-gateway.vercel.sh/v1/models
FORESIGHT_AI_PROVIDER=gateway
FORESIGHT_AI_MODEL=
AI_GATEWAY_API_KEY=
# AI option B: set provider=google, FORESIGHT_AI_MODEL to an actual Google model ID,
# and GOOGLE_GENERATIVE_AI_API_KEY. Direct Google credentials are not Gateway keys.
GOOGLE_GENERATIVE_AI_API_KEY=
# Existing production Gemini names remain supported. For legacy fallback remove
# FORESIGHT_AI_PROVIDER and FORESIGHT_AI_MODEL, or explicitly set provider=google.
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional external simulator; unset on Vercel for bundled stateless Python compute.
FORESIGHT_SIMULATOR_URL=
# Same strong random token in Next and all workers. Required on Vercel.
FORESIGHT_WORKER_TOKEN=
FORESIGHT_SIMULATOR_PORT=8100
FORESIGHT_JOB_DATABASE=.minetech-data/simulator-jobs.sqlite

# Separate persistent Python CPU service; no inference runs in the browser or Next.
# Next uses authenticated GET /health and enables controls only for a loaded model.
FORESIGHT_VISION_URL=
# Worker-only absolute path to reviewed manifest and licensed weights.
FORESIGHT_VISION_MANIFEST=
FORESIGHT_VISION_DATA=.minetech-data/vision
FORESIGHT_VISION_HOST=127.0.0.1
FORESIGHT_VISION_PORT=8200
FORESIGHT_ENV=development
FORESIGHT_HARDWARE=
FORESIGHT_INGEST_URL=http://127.0.0.1:3000/api/vision/events
# Optional operator-owned live-feed mapping; recorded MP4 is the primary workflow.
FORESIGHT_CAMERA_FEEDS_FILE=
FORESIGHT_CAMERA_FEED_ALIAS=
