# Next.js reads .env.local. Python workers need their own exported environment.
# Copy names only to Vercel project Settings > Environment Variables, then redeploy.
# All values below are SERVER ONLY. Never use NEXT_PUBLIC_ for secrets.
# See docs/INTEGRATIONS_SETUP.md for exact setup, health checks and asset requirements.

# Hosted: use the Supabase transaction-pooler URI with TLS, or integration POSTGRES_URL.
# Local development: leave both unset to use isolated SQLite.
DATABASE_URL=
POSTGRES_URL=
BETTER_AUTH_URL=http://localhost:3000
# Required in production; generate privately with openssl rand -hex 32.
BETTER_AUTH_SECRET=
FORESIGHT_TRUSTED_ORIGINS=
FORESIGHT_DATABASE_PATH=
# Private Vercel Blob integration token; never use public storage for clips.
BLOB_READ_WRITE_TOKEN=

# AI option A: AI Gateway. Use provider/model ID from https://ai-gateway.vercel.sh/v1/models
FORESIGHT_AI_PROVIDER=gateway
FORESIGHT_AI_MODEL=
AI_GATEWAY_API_KEY=
# AI option B: set provider=google, FORESIGHT_AI_MODEL to an actual Google model ID,
# and GOOGLE_GENERATIVE_AI_API_KEY. Direct Google credentials are not Gateway keys.
GOOGLE_GENERATIVE_AI_API_KEY=
# Existing production Gemini names remain supported. For legacy fallback remove
# FORESIGHT_AI_PROVIDER and FORESIGHT_AI_MODEL, or explicitly set provider=google.
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional external simulator; unset on Vercel for bundled stateless Python compute.
FORESIGHT_SIMULATOR_URL=
# Same strong random token in Next and all workers. Required on Vercel.
FORESIGHT_WORKER_TOKEN=
FORESIGHT_SIMULATOR_PORT=8100
FORESIGHT_JOB_DATABASE=.minetech-data/simulator-jobs.sqlite

# Separate persistent Python CPU service; no inference runs in the browser or Next.
# Next uses authenticated GET /health and enables controls only for a loaded model.
FORESIGHT_VISION_URL=
# Worker-only absolute path to reviewed manifest and licensed weights.
FORESIGHT_VISION_MANIFEST=
FORESIGHT_VISION_DATA=.minetech-data/vision
FORESIGHT_VISION_HOST=127.0.0.1
FORESIGHT_VISION_PORT=8200
FORESIGHT_ENV=development
FORESIGHT_HARDWARE=
FORESIGHT_INGEST_URL=http://127.0.0.1:3000/api/vision/events
# Optional operator-owned live-feed mapping; recorded MP4 is the primary workflow.
FORESIGHT_CAMERA_FEEDS_FILE=
FORESIGHT_CAMERA_FEED_ALIAS=

# ---- MineTech v2 messaging (docs/MESSAGING_SETUP.md) ----
# dry-run (default): outbox only, nothing is sent. allow-list: only numbers in
# MESSAGING_TEST_NUMBERS. live: also needs an administrator to enable it in
# workspace settings. Automation never sets live.
MESSAGING_MODE=dry-run
# Comma-separated E.164 numbers of consenting test phones, e.g. +2637...,+2637...
MESSAGING_TEST_NUMBERS=
# 32 random bytes, base64 (openssl rand -base64 32). Seals phone numbers at rest.
# Required in production; keep it stable (changing it makes stored numbers unreadable).
FORESIGHT_PERSONAL_DATA_KEY=
# SMSGate (Android SMS gateway). Cloud: https://api.sms-gate.app/3rdparty/v1 ;
# local/private server: the device or server base URL. Username/password or token.
SMSGATE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_TOKEN=
# Optional second gateway phone used when the first fails.
SMSGATE_SECONDARY_URL=
SMSGATE_SECONDARY_USERNAME=
SMSGATE_SECONDARY_PASSWORD=
# Secret appended to the webhook URL registered in SMSGate (>= 24 chars):
# https://<host>/api/messaging/sms?token=<SMSGATE_WEBHOOK_TOKEN>
SMSGATE_WEBHOOK_TOKEN=
SMSGATE_LOW_BATTERY_PERCENT=20
SMSGATE_HEALTH_INTERVAL_MS=60000
# WhatsApp Cloud API (official). Webhook: https://<host>/api/messaging/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version shown in your Meta app dashboard, e.g. vNN.0 (no default is assumed)
WHATSAPP_GRAPH_VERSION=
# Approved templates for business-initiated messages, by Foresight template key:
# {"reminder.miner":{"name":"...","language":"en","approved":true,"params":["time","shaft"]}}
WHATSAPP_TEMPLATES={}
MESSAGING_TICK_MS=5000
# PPE vision is frozen; set to 1 only for internal testing.
FORESIGHT_FEATURE_VISION=

# ---- Phase 6: rain forecast (docs/MESSAGING_SETUP.md) ----
# Forecasts come from Open-Meteo's free endpoint (non-commercial use only). A paid
# deployment must use a commercial or self-hosted endpoint here.
OPEN_METEO_BASE_URL=
# Minutes between forecast requests per mine (default 180).
WEATHER_POLL_MINUTES=180
# How often the messaging service polls forecasts and refreshes ageing evidence (ms).
CONCERNS_MAINTAIN_INTERVAL_MS=300000
