# Hosted database (Supabase/Neon transaction-pooler URI); keep server-only.
DATABASE_URL=
# POSTGRES_URL from a Vercel integration is also supported.
# Local development: npm run dev. No provider credentials are required for manual reporting.
# For another browser origin, set the exact URL (and optionally comma-separated trusted origins).
BETTER_AUTH_URL=http://localhost:3000
# Required for any production-mode hosting. Generate a private random secret; never commit it.
BETTER_AUTH_SECRET=
FORESIGHT_TRUSTED_ORIGINS=
# Persistent local disk; default .minetech-data/foresight.sqlite. Not serverless ephemeral storage.
FORESIGHT_DATABASE_PATH=
# Optional external simulator. Leave URL unset on Vercel to use bundled Python compute.
# Node calls an external worker only when this URL is explicitly configured.
FORESIGHT_SIMULATOR_URL=
FORESIGHT_WORKER_TOKEN=
FORESIGHT_JOB_DATABASE=.minetech-data/simulator-jobs.sqlite
# Optional real extraction / explanation via AI SDK. Select a currently supported model from the live catalog.
AI_GATEWAY_API_KEY=
FORESIGHT_AI_MODEL=
# Optional actual vision service. Omit URL to keep the UI explicitly unavailable.
FORESIGHT_VISION_URL=
FORESIGHT_VISION_MANIFEST=
FORESIGHT_VISION_DATA=.minetech-data/vision
FORESIGHT_HARDWARE=
FORESIGHT_INGEST_URL=http://127.0.0.1:3000/api/vision/events
# Operator-owned JSON mapping aliases to stream URLs; never put credentials in browser fields.
FORESIGHT_CAMERA_FEEDS_FILE=
FORESIGHT_CAMERA_FEED_ALIAS=
