{
  "name": "foresight-minetech",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:assistant": "node --experimental-strip-types --test tests/assistant.test.ts",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/assistant.test.ts",
    "test:python": "python -m unittest services.simulator.test_engine services.simulator.test_jobs services.simulator.test_transport services.simulator.test_serverless services.vision.test_policy -v",
    "test:browser": "playwright test",
    "test:vision-runtime": ".venv/bin/python -m unittest services.vision.test_runtime -v",
    "evaluate:numerical": "python -m tools.evaluation.numerical",
    "contracts": "node --experimental-strip-types scripts/export-contracts.ts",
    "migrate:legacy": "node --experimental-strip-types scripts/migrate-legacy.ts",
    "worker:simulator": "python -m services.simulator.server",
    "worker:vision": ".venv/bin/python -m services.vision.server",
    "preview": "node scripts/start-local.mjs",
    "test:postgres": "node --experimental-strip-types --test tests/postgres-auth.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate-db.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@vercel/blob": "^2.7.0",
    "ai": "^7.0.143",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "type": "module"
}
